# Copier ce fichier en backend/.env et remplir les valeurs.
# Ne jamais commiter backend/.env.

# PostgreSQL avec l'extension pgvector
DATABASE_URL=postgresql://user:password@localhost:5432/ragsaas

# Secret de signature des JWT (32 caracteres minimum). Pour en generer un :
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Embeddings (https://jina.ai) et LLM (https://console.groq.com)
JINA_API_KEY=
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Observabilite (optionnel) : https://langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# Rate limiting derriere un reverse proxy : nombre de proxys de confiance qui
# ajoutent une entree a X-Forwarded-For (0 = IP de connexion directe).
# LOG_CLIENT_IP=1 logue l'IP vue par l'app pour choisir la bonne valeur ; a retirer ensuite.
# TRUSTED_PROXY_HOPS=0
# LOG_CLIENT_IP=0

# Serveur MCP : id du compte dont les bots sont exposes a Claude Desktop
# MCP_USER_ID=

# Scripts d'evaluation (eval/) : id du bot qui contient le PDF d'evaluation
# EVAL_BOT_ID=
